# Copy to .env for local dev. Never commit the real .env.
#
# Server-side (TanStack Start server fns + /api/public/cron/* routes)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback still read by several cron routes and breadth.functions.ts
SUPABASE_ANON_KEY=
# Server-only. Must never be exposed to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Authenticates every /api/public/cron/* route via the x-cron-secret header.
# 32+ chars. If unset the routes fail closed.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Base URL the app uses to call its own cron routes (breadth.functions.ts).
# TODO: rename to APP_URL as part of the Lovable exit.
LOVABLE_PROJECT_URL=

# Client-side. Vite inlines VITE_* AT BUILD TIME, so these must be present
# during `bun run build` — setting them only at runtime will not work.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STANDALONE_AUTH=true
